#!/bin/bash
set -xe

# detect distro
. /etc/os-release
distro="$ID"

# git setup
if [[ -z "$GITUSER" || -z "$GITEMAIL" ]]; then
    echo "Error: GITUSER and GITEMAIL variables must be set." >&2
    exit 1
fi

git config --global user.name "$GITUSER"
git config --global user.email "$GITEMAIL"
git config --global init.defaultBranch master

# base packages
packages="zsh vim git curl"

# distro-specific setup
if [[ "$distro" == "arch" ]]; then

    sudo pacman -Syu --noconfirm
    sudo pacman -S --needed --noconfirm base-devel git

    mkdir -p "$HOME/build"

    # install trizen
    if [[ ! -d "$HOME/build/trizen" ]]; then
        git clone https://aur.archlinux.org/trizen.git "$HOME/build/trizen"
    fi

    cd "$HOME/build/trizen"
    makepkg -si --noconfirm
    cd "$HOME"

    aur_packages="polybar"

    # terminal
    packages+=" rxvt-unicode"
    term="rxvt-unicode"
    terminal="rxvt-unicode"

    # xorg
    packages+=" xorg-server xorg-xinit xorg-xset xorg-xrandr"

    echo "REMINDER: install graphics driver"

    ln -sfn "$HOME/.dots/config/xorg/xinitrc" "$HOME/.xinitrc"
    ln -sfn "$HOME/.dots/config/xorg/xResources" "$HOME/.Xresources"

    # compositor
    packages+=" picom"

    # wm
    packages+=" i3 dmenu"

    mkdir -p "$HOME/.config"

    ln -sfn "$HOME/.dots/config/i3" "$HOME/.config/i3"

    # polybar
    ln -sfn "$HOME/.dots/config/polybar" "$HOME/.config/polybar"
    chmod +x "$HOME/.config/polybar/launch.sh"

    # lock
    packages+=" i3lock"

    ln -sfn "$HOME/.dots/bin/lock" "$HOME/.lock"
    chmod +x "$HOME/.lock"

    # wallpaper
    packages+=" feh"

    ln -sfn "$HOME/.dots/bin/fehbg" "$HOME/.fehbg"
    chmod +x "$HOME/.fehbg"

    echo "REMINDER: save wallpaper to ~/.wallpaper"

    # fonts
    packages+=" noto-fonts"

    # audio
    packages+=" pulseaudio pulseaudio-alsa"

    # ssh
    packages+=" openssh"

    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"

    # extras
    packages+=" htop"

    # install packages
    sudo pacman -S --needed --noconfirm $packages

    if [[ -n "$aur_packages" ]]; then
        trizen -S --needed --noconfirm $aur_packages
    fi

    # pacman config
    sudo ln -sfn "$HOME/.dots/config/pacman/pacman.conf" /etc/pacman.conf

elif [[ "$distro" == "ubuntu" ]]; then

    term="gnome-terminal"
    terminal="gnome-terminal"

    sudo apt update
    sudo apt upgrade -y

    sudo apt install -y $packages

else
    echo "unknown distro: $distro"
    exit 1
fi

# ssh config
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

cp "$HOME/.dots/config/ssh/config" "$HOME/.ssh/config"
chmod 644 "$HOME/.ssh/config"

# set default shell
sudo chsh "$(whoami)" -s "$(which zsh)"

# vim config
ln -sfn "$HOME/.dots/config/vim/vimrc" "$HOME/.vimrc"

# oh-my-zsh
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# themes
ln -sfn \
    "$HOME/.dots/config/zsh/themes/jangui.zsh-theme" \
    "$HOME/.oh-my-zsh/themes/jangui.zsh-theme"

ln -sfn \
    "$HOME/.dots/config/zsh/themes/jangui-ssh.zsh-theme" \
    "$HOME/.oh-my-zsh/themes/jangui-ssh.zsh-theme"

# zsh syntax highlighting
if [[ ! -d "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting" ]]; then
    git clone \
        https://github.com/zsh-users/zsh-syntax-highlighting.git \
        "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"
fi

chmod -R go-w "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"

# zsh config
ln -sfn "$HOME/.dots/config/zsh/zshrc" "$HOME/.zshrc"

touch "$HOME/.custom_rc"
ln -sfn "$HOME/.custom_rc" "$HOME/.dots/config/zsh/custom_rc"

if ! grep -q "export TERM=" "$HOME/.dots/config/zsh/custom_rc"; then
    echo "export TERM=$term" >> "$HOME/.dots/config/zsh/custom_rc"
fi

if ! grep -q "export TERMINAL=" "$HOME/.dots/config/zsh/custom_rc"; then
    echo "export TERMINAL=$terminal" >> "$HOME/.dots/config/zsh/custom_rc"
fi

touch "$HOME/.zprofile"

# startx on tty login
if [[ "$distro" == "arch" ]]; then
    if ! grep -q "^startx$" "$HOME/.zprofile"; then
        echo "startx" >> "$HOME/.zprofile"
    fi
fi

# trash folders
mkdir -p "$HOME/.trashcan"
sudo mkdir -p /root/.trashcan

echo "Setup successful!"
