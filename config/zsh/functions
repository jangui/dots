# ~/.dots/config/zsh/functions

rm_crap() {
  rm -rf "$HOME/Dropbox/.dropbox.cache/"*
}

cd() {
  builtin cd "${1:-$HOME}" || return
  pwd > "$HOME/.pwd"
}

del() {
  mkdir -p "$HOME/.trashcan"

  for filename in "$@"; do
    if [[ ! -e "$filename" && ! -L "$filename" ]]; then
      echo "No such file or directory: $filename"
      continue
    fi

    basefilename="$(basename "$filename")"

    if [[ -e "$HOME/.trashcan/$basefilename" ]]; then
      new_name="$basefilename.$(date +"%s")"
    else
      new_name="$basefilename"
    fi

    mv -- "$filename" "$HOME/.trashcan/$new_name" 2>/dev/null ||
      sudo mv -- "$filename" "$HOME/.trashcan/$new_name"
  done
}

trash() {
  rm -rf "$HOME/.trashcan" 2>/dev/null ||
    sudo rm -rf "$HOME/.trashcan"

  mkdir -p "$HOME/.trashcan"
}

upload() {
  if [[ $# -ne 2 ]]; then
    echo "usage: upload <user>@<host> <file>"
    return 1
  fi

  local destination="$1"
  local target="$2"

  if [[ ! -e "$target" ]]; then
    echo "No such file or directory: $target"
    return 1
  fi

  if [[ -d "$target" ]]; then
    local compressed="$HOME/$(basename "$target").tar.gz"

    tar zcf "$compressed" "$target" || return 1
    sftp "$destination" <<< "put $compressed"
    rm -f "$compressed"
    return
  fi

  sftp "$destination" <<< "put $target"
}

enter() {
  if [[ -z "$1" ]]; then
    echo "usage: enter <container-name-fragment>"
    return 1
  fi

  local found
  found="$(docker ps | grep "$1" | awk '{print $1}' | head -1)"

  if [[ -z "$found" ]]; then
    echo "no containers found associated with '$1'"
    return 1
  fi

  docker exec -it "$found" sh
}

ssha() {
  eval "$(ssh-agent -s)"
  ssh-add "$HOME/.ssh/id_rsa"
  ssh-add "$HOME/.ssh/id_rsa_git"
}

entry() {
  local dir="$ENTRIES_DIR"
  local filename
  local filepath

  if [[ -z "$dir" ]]; then
    echo "ENTRIES_DIR is not set"
    return 1
  fi

  mkdir -p "$dir"

  filename="$(date +"%Y-%m-%d-%H%M").md"
  filepath="$dir/$filename"

  vim "$filepath"
}

clipcopy() {
  if command -v pbcopy >/dev/null; then
    pbcopy
  elif command -v wl-copy >/dev/null; then
    wl-copy
  elif command -v xclip >/dev/null; then
    xclip -selection clipboard
  elif command -v xsel >/dev/null; then
    xsel --clipboard --input
  else
    echo "No clipboard copy utility found" >&2
    return 1
  fi
}

clippaste() {
  if command -v pbpaste >/dev/null; then
    pbpaste
  elif command -v wl-paste >/dev/null; then
    wl-paste
  elif command -v xclip >/dev/null; then
    xclip -selection clipboard -o
  elif command -v xsel >/dev/null; then
    xsel --clipboard --output
  else
    echo "No clipboard paste utility found" >&2
    return 1
  fi
}
